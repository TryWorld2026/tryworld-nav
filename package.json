{
  "name": "tryworld-portal",
  "version": "1.0.0",
  "private": true,
  "description": "试界导航 — 智能体与 AI 工具导航门户",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "assets:check": "node scripts/sync-assets.mjs --check",
    "assets:push": "node scripts/sync-assets.mjs",
    "preview": "npx serve out -l 3100",
    "deploy": "npm run build && npm run prune && npx wrangler deploy",
    "prune": "node scripts/prune-out.mjs",
    "preview:cf": "npx wrangler dev",
    "media:backup": "node scripts/backup-media.mjs",
    "media:restore": "node scripts/restore-media.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.4.49",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
