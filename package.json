{
  "name": "tryworld-portal",
  "version": "1.0.0",
  "private": true,
  "description": "试界导航 — 智能体与 AI 工具导航门户",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-aihot.mjs && node scripts/fetch-aihot-daily.mjs && node scripts/generate-llms-full.mjs && npm run gen:all && node scripts/generate-sw.mjs && npm run gen:thumbs && next build",
    "start": "next start",
    "lint": "eslint .",
    "gen:nav": "node scripts/generate-nav.mjs",
    "gen:search-index": "node scripts/generate-search-index.mjs",
    "gen:all": "node scripts/generate-nav.mjs && node scripts/generate-search-index.mjs",
    "gen:check": "node scripts/generate-nav.mjs --check && node scripts/generate-search-index.mjs --check",
    "gen:thumbs": "node scripts/gen-thumbs.mjs",
    "gen:pwa-icons": "node scripts/gen-pwa-icons.mjs",
    "verdicts:check": "node scripts/check-verdicts.mjs",
    "extras:check": "node scripts/check-extras.mjs",
    "verdicts:draft": "node scripts/draft-verdicts.mjs --limit 200",
    "assets:check": "node scripts/sync-assets.mjs --check",
    "assets:push": "node scripts/sync-assets.mjs",
    "media:check": "node scripts/check-media.mjs",
    "preview": "npx serve out -l 3100",
    "deploy": "node scripts/deploy.mjs",
    "prune": "node scripts/prune-out.mjs",
    "preview:cf": "npx wrangler dev",
    "media:backup": "node scripts/backup-media.mjs",
    "media:restore": "node scripts/restore-media.mjs",
    "census": "node scripts/census.mjs",
    "news:fetch": "node scripts/fetch-aihot.mjs",
    "news:refresh": "node scripts/fetch-aihot.mjs --force",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:unit": "node --test \"tests/news.test.mjs\" \"tests/news-period.test.mjs\" \"tests/fetch-aihot.test.mjs\" \"tests/search.test.mjs\" \"tests/favorites.test.mjs\" \"tests/filter-url.test.mjs\"",
    "test:interaction": "node --test \"tests/interaction.test.mjs\"",
    "news:daily": "node scripts/fetch-aihot-daily.mjs",
    "news:daily:refresh": "node scripts/fetch-aihot-daily.mjs --force"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
