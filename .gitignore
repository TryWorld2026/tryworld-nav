# Dependencies
/node_modules
/.next
/out

# Media — 336 MB of product icons and screenshots. These live on Cloudflare R2
# (see scripts/sync-assets.mjs) and are pulled into the build through
# NEXT_PUBLIC_ASSET_BASE, so they are deliberately not in the repo. GitHub
# warns above ~1 GB and hard-blocks files over 100 MB, and every CI checkout
# would otherwise download the whole catalog's media.
#
# `assets/site/` is the exception and stays in git: the favicons and the social
# card belong on the site's own origin — browsers and some scrapers dislike
# cross-origin favicons — and the four files total 16 KB.
/public/assets/icons
/public/assets/shots
/public/assets/tags
/public/assets/news

# Generated thumbnails — 2082 icons (88w + 176w) + 2081 shots @800w of webp,
# produced from the two directories above by `scripts/gen-thumbs.mjs`. They are
# build artifacts, not assets: never hand-edit one, and they can be rebuilt in
# about a minute. Same reasoning as the media they derive from — the deploy copies
# whatever is in `public/`, so a fresh clone needs one run of the script before
# `npm run deploy`, or every srcSet candidate 404s. `npm run build` runs it.
#
# NOT gitignored next to them: `src/thumbs.json`, the two-number manifest that is
# the page-side switch for "emit srcSet at all". It lives in `src/` because the
# component reading it is also in the client bundle and cannot touch `fs`; it must
# therefore exist in the checkout. It is committed at the counts of this machine's
# media, and `npm run build` rewrites it from the filesystem right before
# `next build` — so on a media-less CI checkout it comes out as 0/0, which makes
# every page degrade to plain `<img src>` instead of pointing at files that are
# not there. Do not hand-edit it.
/public/assets/thumbs

# Wrangler local state
.wrangler

# Local env
.env
.env.local
.env.*.local

# Editors / OS
.DS_Store
Thumbs.db
.idea
.vscode

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch space for one-off analysis scripts and captured command output.
# `public/llms-full.txt` belongs here too: it is 8.3 MB and is regenerated by
# `npm run build` (`scripts/generate-llms-full.mjs`), so tracking it would only
# grow the repo and let the committed copy drift from `data/`.
/work
/public/llms-full.txt
